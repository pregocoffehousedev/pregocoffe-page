# ---------- Sitio ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EVENTO_SLUG=plantitas-y-cafe-4

# ---------- Supabase ----------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # SECRETO — nunca exponer al cliente

# ---------- Emails (Resend) ----------
# Solo se usa para las cotizaciones de eventos privados (formulario "Arrienda
# el local" / "Coffee Break"). Las entradas del bingo van por transferencia +
# WhatsApp, sin email.
RESEND_API_KEY=re_...
RESEND_FROM=Pregò Coffee <hola@tudominio.cl>
# A dónde llegan las solicitudes de eventos privados (por defecto: LOCAL.email)
EVENTOS_EMAIL=hola@pregocoffee.cl

# ---------- Rate limiting (opcional en dev) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Seguridad ----------
CRON_SECRET=genera-uno-con-openssl-rand-hex-32
# El panel /admin/* ya no usa un token manual: se protege con Google OAuth
# vía Supabase Auth (ver src/lib/adminAuth.ts). Configurar el proveedor
# Google en Supabase Dashboard > Authentication > Providers.
